# ────────────────────────────────────────────────────────────
#  Zynex — Environment Configuration
# ────────────────────────────────────────────────────────────
#  Copy this file to .env if you want to configure manually.
#  Otherwise, just run the app — the web UI has a one-click
#  "Activate free AI" button that provisions a key via OpenRouter.
# ────────────────────────────────────────────────────────────

# ── OpenRouter API Key ──────────────────────────────────────
# Optional — the app runs in demo mode without it.
# You can also set it manually:
#   1. Go to https://openrouter.ai and create a free account
#   2. Dashboard → Keys → Create Key
#   3. Paste below
OPENROUTER_API_KEY=

# ── LLM Model ──────────────────────────────────────────────
# The default model to use via OpenRouter.
# Default (verified free on 2026-11-07): google/gemma-4-31b-it:free
# Other free models offered in the UI:
#   - nvidia/nemotron-3.5-lightning:free
#   - nvidia/nemotron-3-ultra-550b-a55b:free
# Paid options work too if your account has credit.
DEFAULT_MODEL=google/gemma-4-31b-it:free

# Maximum tokens per LLM response
MAX_TOKENS=4096

# ── Server Configuration ───────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to false for production / container deployments
RELOAD=false

# Comma-separated origins allowed to call the API from another origin.
# The bundled frontend is same-origin, so this can usually stay unset.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
